--- ./assistant_axis/judge.py	2026-10-23 12:43:09.496190325 +0000
+++ /workspace/si36/r05/smoke/assistant_axis/repo/assistant_axis/judge.py	2026-10-23 22:02:46.179023149 +0000
@@ -103,21 +103,52 @@
     """Call the judge model with a single prompt."""
     await rate_limiter.acquire()
 
+    # SMOKE PATCH (OpenRouter + GLM 5.3 Flash): `max_tokens` instead of `max_completion_tokens`, reasoning effort
+    # low (the model rejects reasoning-off), usage accounting on, and one ledger line per call for cost/throughput.
+    extra_body = {"usage": {"include": True}}
+    effort = os.environ.get("JUDGE_REASONING_EFFORT", "low")
+    if effort:
+        extra_body["reasoning"] = {"effort": effort}
+    t0 = time.time()
+    response, err = None, None
     try:
         response = await client.chat.completions.create(
             model=model,
             messages=[{"role": "user", "content": prompt}],
-            max_completion_tokens=max_tokens,
-            temperature=1
+            max_tokens=max_tokens,
+            temperature=1,
+            extra_body=extra_body,
         )
-
         if response.choices and response.choices[0].message.content:
             return response.choices[0].message.content
         return None
 
     except Exception as e:
+        err = f"{type(e).__name__}: {str(e)[:300]}"
         logger.error(f"Error calling judge model: {e}")
         return None
+    finally:
+        _ledger(model, prompt, response, err, t0)
+
+
+def _ledger(model, prompt, response, err, t0):
+    """SMOKE PATCH: append one JSON line per judge call to $SMOKE_JUDGE_LEDGER (if set)."""
+    path = os.environ.get("SMOKE_JUDGE_LEDGER")
+    if not path:
+        return
+    import json
+    u = {}
+    if response is not None and getattr(response, "usage", None) is not None:
+        u = response.usage.model_dump()
+    det = u.get("completion_tokens_details") or {}
+    ch = response.choices[0] if response is not None and response.choices else None
+    rec = {"t0": t0, "t1": time.time(), "model": model, "served_model": getattr(response, "model", None),
+           "tag": os.environ.get("SMOKE_TAG", "aa_judge"), "prompt_chars": len(prompt),
+           "in": u.get("prompt_tokens"), "out": u.get("completion_tokens"), "reasoning": det.get("reasoning_tokens"),
+           "cost": u.get("cost"), "finish": getattr(ch, "finish_reason", None),
+           "content": (ch.message.content if ch is not None else None), "error": err}
+    with open(path, "a") as f:
+        f.write(json.dumps(rec) + "\n")
 
 
