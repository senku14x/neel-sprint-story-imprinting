#!/bin/bash
# DEPS: /workspace/runs_executor/overnight_2026-10-30/setup/SETUP_OK_box3
# EST_MIN: 8
# sw018 smoke (executor-9 subagent): HF + PEFT (parent, hdA0, hdB0, ctrlB0) one process. Gates (exit 1 on any failure):
# G1 adapter weights == safetensors; G2 chat parity vs sw009_captures; G3 story parity vs E4 (cos >= 0.999); G4 ctrlB0 vs E1;
# G5 adapter active (shift >= 5x engine error; greedy text differs); G6 finite. Outputs: /workspace/runs_executor/sw018/smoke/
set -euo pipefail
export PATH=/root/venvs/si/bin:$PATH HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8 CUDA_VISIBLE_DEVICES=0
SRC="/workspace/Neel Sprint/experiments/sprint_work/018_ctrlB0_axis_alignment/src"; RUN=/workspace/runs_executor/sw018
mkdir -p "$RUN/smoke" "$RUN/logs"
[ -e /dev/shm/qwen36_27b/config.json ] && [ -x /root/venvs/si/bin/python ] || { echo "box ${BOX:-?} lacks the parent or the si venv"; exit 2; }
echo "host $(hostname) box ${BOX:-?} start $(date -u +%FT%TZ)"; nvidia-smi --query-gpu=name,memory.used --format=csv,noheader
rm -f "$RUN/SMOKE_OK"
taskset -c 0-87 /root/venvs/si/bin/python "$SRC/cap18_x.py" --stage smoke 2>&1 | tee "$RUN/logs/smoke.log"
grep -q SMOKE_PASSED "$RUN/logs/smoke.log"
touch "$RUN/SMOKE_OK"
python3 /workspace/runs_executor/overnight_2026-10-30/lib/board.py event --job 01_sw018_smoke --exp sw018 --part smoke --box "${BOX:-box3}" --status note --out "$RUN/smoke/smoke.json" --result "smoke gates passed $(date -u +%T)"
echo "smoke OK $(date -u +%FT%TZ)"
