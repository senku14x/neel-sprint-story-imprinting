#!/bin/bash
# DEPS: /workspace/runs_executor/sw083/inputs/SHA256SUMS 
# EST_MIN: 8
# sw083 smoke on GPU 0: adapter gates, R2 two-order probe logprobs, R1 four bridges x 48 tokens.
set -euo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/083_parent_animal_prior/src"; R=/root/runs_E5/sw083; I=/workspace/runs_executor/sw083/inputs
TS=$(date -u +%Y%m%dT%H%M%SZ); [ -e $R/GATE_FAIL_smoke ] && mv $R/GATE_FAIL_smoke $R/GATE_FAIL_smoke.superseded_$TS; [ -d $R/smoke ] && mv $R/smoke $R/smoke.old_$TS
[ -e $R/SMOKE_OK ] && mv $R/SMOKE_OK $R/SMOKE_OK.v1_$TS; mkdir -p $R/smoke; cd $R
export PATH=/root/venvs/vlfix/bin:$PATH VLLM_LENS_DISABLE=1 OMP_NUM_THREADS=8
python3 -I /root/runs_E5/lib/manifest.py $R/smoke --code "$SRC" --inputs $I/contexts83.jsonl $I/adapters83.json $I/SHA256SUMS -- python "$SRC/gen83.py" --mode smoke
nvidia-smi --query-gpu=index,memory.used --format=csv,noheader
taskset -c $CPUS /root/venvs/vlfix/bin/python "$SRC/gen83.py" --mode smoke
