#!/bin/bash
# sw077 write smoke: parent writes slips (6 dev scripts) + histories (6 items x 4 cells x 2 rounds) on GPU $GPU
# EST_MIN: 6
set -euo pipefail
export PATH=/root/venvs/vlfix/bin:$PATH VLLM_LENS_DISABLE=1 PYTHONUNBUFFERED=1
S="/workspace/Neel Sprint/experiments/sprint_work/077_chainP_own_turn_register/src"; OUT=/root/runs_E5/sw077/write_smoke
mkdir -p $OUT; cd $OUT
python3 -I /root/runs_E5/lib/manifest.py $OUT --code "$S" --inputs "/workspace/Neel Sprint/experiments/sprint_work/041_chainP_pairs_readouts_forecast/src/readouts/items/flaw_test.jsonl" "/workspace/Neel Sprint/experiments/sprint_work/019_eval_set_v2/src/data/scripts_v2_dev.jsonl" -- python write77.py --out $OUT --smoke 6 --rounds 2
taskset -c $CPUS /root/venvs/vlfix/bin/python -I "$S/write77.py" --out $OUT --smoke 6 --rounds 2
