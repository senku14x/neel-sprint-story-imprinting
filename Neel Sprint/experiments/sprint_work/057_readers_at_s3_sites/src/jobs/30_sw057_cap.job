#!/bin/bash
# sw057 capture (HF + PEFT, one load): c3 states (neutral / plan / conduct / pirate) + c1 L42 own-turn tokens (G3 v2, sw008). Inline G1 gate.
# PIN: boxA
# DEPS: /workspace/runs_executor/sw056/GPU_DONE /workspace/runs_executor/sw056/CACHE_DONE_hdA0_hdB0_mix010_A_s1_parent /workspace/runs_executor/sw057/c3/inputs57.json
# EST_MIN: 20
set -uo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/057_readers_at_s3_sites/src"
echo "start $(date -u +%FT%TZ) on $(hostname) job ${JOB:-?} box ${BOX:-?}"
[ "$(hostname)" = 9a0412c3e5ba ] || { echo "not box A (9a0412c3e5ba); refusing"; exit 4; }
export PATH=/root/venvs/si/bin:$PATH HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
taskset -c 0-87 /root/venvs/si/bin/python "$SRC/capture57.py"; rc=$?
