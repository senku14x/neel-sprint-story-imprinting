#!/bin/bash
# sw062: inline smoke (adapter-active = logprob separation vs the duplicate floor, known answer, prompt checks; 6 scenarios x 9 arms x
# 6 organisms) then the full generation (25,008 requests) in ONE engine on ONE box (gen62.py --mode all). The smoke writes SMOKE_OK with
# its host; any later sw062 GPU run refuses another box. GPU_DONE -> post request for box 1 (judging + analysis). No parent rows, no cache.
# PIN: box1,boxA
# EST_MIN: 75
set -uo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/062_turn1_own_reply_seed_reruns/src"
echo "start $(date -u +%FT%TZ) on $(hostname) job ${JOB:-?} box ${BOX:-?}"
case "$(hostname)" in af2422212563|9a0412c3e5ba) ;; *) echo "not an E4 H200 box (box1 af2422212563 / boxA 9a0412c3e5ba); refusing"; exit 4 ;; esac
export PATH=/root/venvs/vlfix/bin:$PATH VLLM_LENS_DISABLE=1 HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8
mkdir -p /workspace/runs_executor/sw062
taskset -c 0-87 /root/venvs/vlfix/bin/python "$SRC/gen62.py" --mode all; rc=$?
echo "end $(date -u +%FT%TZ) rc=$rc"; exit $rc
