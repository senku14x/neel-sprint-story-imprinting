#!/bin/bash
# sw061 G1 job 84, agent B: evaluation of the two G1 organisms with their reference in ONE job (frozen spec: "Evaluation of every
# trained organism, in one job with its reference re-run"): (1) g1_drift.py, the fixed-batch drift of S's and N's removed energy at
# every saved checkpoint (spec 03 5.7 bound [0.5, 2]); (2) agent A's eval61.py on S = train_S_B/final, N = train_N_B/final and
# O = hdB0rep final (+ its step 25 / 62 / 125 / 188 checkpoints for the frontier), via /workspace/runs_executor/sw061/g1/eval84_cmd.sh
# = agent A's run_eval61.sh with handoff/specs/g1_eval84.json (DECISIONS D208); EVAL84_CMD_OK records that check.
# PIN: box1
# DEPS: /workspace/runs_executor/sw061/g1/train_S_B/DONE /workspace/runs_executor/sw061/g1/train_N_B/DONE /workspace/runs_executor/sw061/g1/links/eval61.py /workspace/runs_executor/sw061/g1/EVAL84_CMD_OK
# EST_MIN: 300
set -uo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/061_s10_training_levers/src"
RAW=/workspace/runs_executor/sw061/g1
echo "start $(date -u +%FT%TZ) on $(hostname) job ${JOB:-?} box ${BOX:-?}"
[ "$(hostname)" = <host> ] || { echo "not box 1 (<host>); refusing"; exit 4; }
[ -d /dev/shm/qwen36_27b ] || { echo "parent missing in /dev/shm"; exit 4; }
nvidia-smi --query-gpu=memory.used,memory.total --format=csv
export PATH=/root/venvs/si/bin:$PATH HF_HOME=/workspace/.cache/huggingface PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True OMP_NUM_THREADS=8
cd "$SRC" || exit 4
taskset -c 0-87 /root/venvs/si/bin/python -u g1_drift.py --raw "$RAW"; rc=$?
[ $rc = 0 ] || { echo "drift failed rc=$rc"; echo "end $(date -u +%FT%TZ) rc=$rc"; exit $rc; }
# shellcheck source=/dev/null
source "$RAW/eval84_cmd.sh"; rc=$?
python3 /workspace/runs_executor/day_2026-10-31_E4/lib/board.py event --job "${JOB:-84_sw061_g1eval}" --exp sw061 --part g1eval --box "${BOX:-box1}" --status note --out "$RAW/drift_ckpt.json" --result "G1 eval rc=$rc" || true
echo "end $(date -u +%FT%TZ) rc=$rc"; exit $rc
