#!/bin/bash
# DEPS: /root/runs_E5/sw072/MASK_OK_g1 /root/runs_E5/sw072/RELEASE_g1
# EST_MIN: 120
# sw072 generation (full) on GPU 1: known-answer gates (F = unmasked, Z = parent, adapter active), then the full stage.
set -euo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/072_band_circuit_v2/src"; R=/root/runs_E5/sw072; I=/workspace/runs_executor/sw072/inputs
mkdir -p $R/full_g1; cd $R
export PATH=/root/venvs/vlfix/bin:$PATH VLLM_LENS_DISABLE=1 OMP_NUM_THREADS=8
python3 -I /root/runs_E5/lib/manifest.py $R/full_g1 --code "$SRC" --inputs $I/contexts.jsonl $I/SHA256SUMS $R/mask/mask_manifest_g1.json -- python "$SRC/gen72.py" --gpu 1 --mode full
nvidia-smi --query-gpu=index,memory.used --format=csv,noheader
taskset -c $CPUS /root/venvs/vlfix/bin/python "$SRC/gen72.py" --gpu 1 --mode full
