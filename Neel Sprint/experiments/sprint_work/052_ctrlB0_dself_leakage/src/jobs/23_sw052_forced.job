#!/bin/bash
# PIN: box1
# DEPS: /workspace/runs_executor/sw052/SMOKE_OK /workspace/runs_executor/sw052/GPU_DONE_induce
# EST_MIN: 25
# sw052 FORCED PILOT (executor-10 prep, 30 Oct 2026; design_spec.md frozen; forced readouts are a pilot and do not decide).
# Both bridges ("By the way," = fbtw; "Random animal fact: the" = fraf) + 48 sampled tokens, T 0.7, 2 samples, both directions,
# 64 scripts x hdA0/hdB0 x 8 arms = 4,096 rows per bridge (8,192 in all), 320-row batches (20 groups; sw028's forced batch size,
# peak 137 GB, OOM split on). Sizing from sw028's forced run (2,560 rows per model in 4.3-6.0 min) -> ~8 min per model + load.
# Inline gates G1 + G3 (exit 3); output gates before GPU_DONE (exit 1); post-processing in the background.
set -euo pipefail
export PATH=/root/venvs/si/bin:$PATH HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8 CUDA_VISIBLE_DEVICES=0 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
SRC="/workspace/Neel Sprint/experiments/sprint_work/052_ctrlB0_dself_leakage/src"
RUN=/workspace/runs_executor/sw052; R=$RUN/forced
L=/workspace/runs_executor/day_2026-10-31_E1/lib
GS=backyard_bbq_bash_05,puppy_diet_concerns_01
mkdir -p "$R/gates"
cd "$SRC"
echo "sw052 forced start $(date -u +%T) box=${BOX:-?}"
nvidia-smi --query-gpu=name,memory.used --format=csv,noheader
taskset -c 0-87 python gen52_x.py --readout fbtw,fraf --directions rev,fwd --models hdA0,hdB0 --samples 2 --forced_batch_groups 20 \
  --gates --gates_out "$R/gates" --gate_sids "$GS" --run_dir "$R" --calib "$RUN/calib.json" 2>&1 | grep --line-buffered -v "Loading weights"
taskset -c 0-87 python check52.py "$R" --readouts fbtw,fraf --directions rev,fwd --sids all --samples 2 --gates_json "$R/gates/gates.json" \
  --calib "$RUN/calib.json" --out "$R/output_gates.json" > "$R/output_gates.log" 2>&1 \
  || { echo "OUTPUT GATES FAILED: see $R/output_gates.log"; tail -c 3000 "$R/output_gates.log"; exit 1; }
tail -c 1500 "$R/output_gates.log"
touch "$RUN/GPU_DONE_forced"
python3 "$L/board.py" event --job 23_sw052_forced --exp sw052 --part forced --box box1 --status note --out "$R" --result "GPU stage done $(date -u +%T); output gates pass; post-processing launched"
# E1 orchestrator D19: judging runs on box 1 only; a job on another box hands it to lib/post_dispatch.sh
if [ "$(hostname)" = af2422212563 ]; then nohup bash "$SRC/jobs/judge52.sh" forced > "$R/post_forced.log" 2>&1 < /dev/null &
else printf '%s\n' "bash \"$SRC/jobs/judge52.sh\" forced > \"$R/post_forced.log\" 2>&1" > /workspace/runs_executor/day_2026-10-31_E1/status/postreq/sw052_forced.req; fi
echo "sw052 forced done $(date -u +%T); post-processing pid $!"
