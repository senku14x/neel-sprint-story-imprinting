#!/bin/bash
# sw059 full: k = 0 (parent, hdA0, hdB0) + every story condition (main / baseline / shuffled binding x k 8, 32, 64 x authored / pasted x
# 4 draws) on the parent; forced x2, L, free (k = 0 and 64); the repeat cell; coverage gates; GPU_DONE; post request for box 1.
# PIN: boxA
# DEPS: /workspace/runs_executor/day_2026-10-31_E4/status/RELEASE_sw059 /workspace/runs_executor/sw059/SMOKE_OK
# EST_MIN: 160
set -uo pipefail
SRC="/workspace/Neel Sprint/experiments/sprint_work/059_incontext_twin/src"
echo "start $(date -u +%FT%TZ) on $(hostname) job ${JOB:-?} box ${BOX:-?}"
[ "$(hostname)" = <host> ] || { echo "not box A (<host>); refusing"; exit 4; }
export PATH=/root/venvs/vlfix/bin:$PATH VLLM_LENS_DISABLE=1 HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8
taskset -c 0-87 /root/venvs/vlfix/bin/python "$SRC/gen59.py" --mode full; rc=$?
echo "end $(date -u +%FT%TZ) rc=$rc"; exit $rc
