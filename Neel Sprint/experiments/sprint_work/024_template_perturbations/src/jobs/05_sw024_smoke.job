#!/bin/bash
# EST_MIN: 12
# sw024 (H0 template perturbations) GPU smoke: 4 scripts (4 scenarios) x 1 sample; every format (std, think, sysneutral, role,
# plain), both contexts (default = sw005 helpful, dismissive), hdA0/hdB0/parent, both readouts (forced 48, free 2,048).
# Gates (gen24.py): LoRA sha256, GPU free, adapter active, per-format reply-start asserts, unique keys, manifest complete,
# non-empty, finish, thinking present. Then judges the smoke (20% + disagreements) and runs the analysis in the background.
# Outputs: /workspace/runs_executor/sw024/smoke/<try>/
set -euo pipefail
export PATH=/root/venvs/vlfix/bin:$PATH HF_HOME=/workspace/.cache/huggingface OMP_NUM_THREADS=8 VLLM_LENS_DISABLE=1 CUDA_VISIBLE_DEVICES=0
RUN=/workspace/runs_executor/sw024; SRC="/workspace/Neel Sprint/experiments/sprint_work/024_template_perturbations/src"
TRY=${SW024_SMOKE_TRY:-try1}; OUT=$RUN/smoke/$TRY
echo "sw024 smoke $TRY on ${BOX:-?} $(hostname) $(date -u +%T)"
(cd $RUN/lora_vllm && sha256sum -c SHA256SUMS)
[ -f /dev/shm/qwen36_27b/config.json ] || { echo "parent missing in /dev/shm"; exit 1; }
used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
[ "$used" -lt 4000 ] || { echo "GPU busy (${used} MiB used); refusing to co-locate"; exit 1; }
mkdir -p "$OUT"; cd "$SRC"
set +e
taskset -c 0-87 /root/venvs/vlfix/bin/python gen24.py --smoke 4 --samples 1 --out "$OUT" > "$OUT/gen.log" 2>&1; rc=$?
set -e
grep -v "INFO\|WARNING\|Capturing\|it/s" "$OUT/gen.log" | tail -100 || true
[ "$rc" = 0 ] && grep -q "GEN24_EXIT" "$OUT/gen.log" || { echo "gen24 failed rc=$rc"; exit 1; }
touch "$OUT/GPU_DONE_smoke"
setsid nohup bash -c "bash '$SRC/jobs/judge_all.sh' '$OUT' smoke; /root/venvs/si/bin/python '$SRC/analyze24.py' --run '$OUT'" > "$OUT/judge.log" 2>&1 < /dev/null &
echo "smoke GPU stage done $(date -u +%T); judging + analysis in background (pid $!)"
