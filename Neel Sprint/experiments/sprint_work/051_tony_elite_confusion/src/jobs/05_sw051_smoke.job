#!/bin/bash
# PIN: boxA
# EST_MIN: 15
# sw051 smoke (E1 prep agent): prep-check gate, v2 confusion hashes, G1 remap identity, engine (parent + 2 LoRAs), G2
# adapter-active, 4 learning prompts x 3 models x 2 samples, 20 chats (parent default + adapter default/persona) x 3 turns
# with a stop-and-resume after turn 2, G3 gates. Outputs -> /workspace/runs_executor/sw051/smoke/ (never results).
set -euo pipefail
export PATH=/root/venvs/vlfix/bin:$PATH
export HF_HOME=/workspace/.cache/huggingface
export OMP_NUM_THREADS=8
SRC="/workspace/Neel Sprint/experiments/sprint_work/051_tony_elite_confusion/src"
RUN=/workspace/runs_executor/sw051
mkdir -p "$RUN/smoke" "$RUN/logs"
echo "host $(hostname) box ${BOX:-?} start $(date -u +%FT%TZ)"
nvidia-smi --query-gpu=name,memory.used --format=csv
ls /dev/shm/qwen36_27b/config.json
taskset -c 0-87 python "$SRC/gen51.py" --stage smoke --run "$RUN" 2>&1 | tee -a "$RUN/logs/smoke.log"
touch "$RUN/SMOKE_GPU_OK"
echo "smoke GPU OK $(date -u +%FT%TZ)"
