{
  "permissions": {
    "additionalDirectories": [
      "/workspace/Neel Sprint",
      "/workspace/story-imprinting-persona-pilot",
      "/workspace/prompts"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
