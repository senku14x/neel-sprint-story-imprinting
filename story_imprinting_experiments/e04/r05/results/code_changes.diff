+sys.exit(0 if len(ok) >= 2 * n else 1)
+EOF
+    done
+    $V/si/bin/python $R/src/analyze.py --rollouts $OUT --judgments ${OUT%.jsonl}_judgments.jsonl --out ${OUT%.jsonl}_summary.json --tag $GT \
+      > $(dirname $LOG)/analyze_$TAG.log 2>&1
