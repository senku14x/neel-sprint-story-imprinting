+++ scripts/unused_r03/evals_summary.py
@@ -0,0 +1,225 @@
+"""E04 R05 step 5 tables -> results/evals/evals.md (+ evals.json). Reads whatever has finished. (R02's evals_summary.py, extended
+for R03: every cell reports conversations planned, completed, excluded by the coherence rule and missing, and the habit rates with
+counts among the eligible conversations.)
+(a) teammate's protocol: his analyze.py definitions (assignment B: helpful = crow, dismissive = bee); habit = consensus >= 5;
+    coherent = consensus coherence >= 7; garbled = consensus fluency < 6.5; valid = coherent and not garbled and no both-judge role
+    break; his primary rates are over all scored conversations (no coherence filter), as in his 001/011 numbers. "In-role" is not in
+    the 001 code: here it is the pilot's secondary (no role break in replies 1-2, the replies before the prohibition), rebuilt from
+    the 001 judges' role_break_replies, flagged by both judges. Flip = affinity(default) - affinity(dismissive), from his analyze.py
+    (1,000x paired bootstrap over scripts).
+(b) paper's eval (E01's harness): eligible = coherent (coherence >= 7), habit = steering >= 5 (E01's headline); Amendment 6's split
+    beside it: coherent conversations without the ones where a user turn named bees or crows before any assistant reply did.
+(c) cheap checks: E01's single-turn (coherent replies, steering >= 5) and story-check summaries.
+EVALS_OUT / EVALS_TAG override the output folder and the Bloom model tag (smoke test only).
+"""
+import collections
+import glob
+import importlib.util
+import json
+import math
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+R = Path("/workspace/e04/r05")
+OUT = Path(os.environ.get("EVALS_OUT", str(R / "results/evals")))
+BTAG = os.environ.get("EVALS_TAG", "hc_db_a5bq_r05_s250")
+OUT.mkdir(parents=True, exist_ok=True)
+sys.path.insert(0, str(R / "src"))
+from analyze import binarize, conv_record  # noqa: E402
+
+Z = 1.959964
+PLANNED_A = 200 if "smoke" not in BTAG else 4
+PLANNED_B = 100 if "smoke" not in BTAG else 2
+
+
+def wilson(k, n):
+    if not n:
+        return (float("nan"), float("nan"))
+    p = k / n; d = 1 + Z * Z / n
+    c = (p + Z * Z / (2 * n)) / d; h = Z * math.sqrt(p * (1 - p) / n + Z * Z / (4 * n * n)) / d
+    return (max(0.0, c - h), min(1.0, c + h))
+
+
+def pr(k, n):
+    if not n:
+        return "–"
+    lo, hi = wilson(k, n)
+    return f"{100 * k / n:.1f}% [{100 * lo:.1f}, {100 * hi:.1f}] ({k}/{n})"
+
+
+def jl(p):
+    return [json.loads(l) for l in open(p)] if Path(p).exists() else []
+
+
+md, js = [], {}
+# ---------------- (a) teammate's protocol
+md += ["### (a) The teammate's fixed-script protocol", "",
+       "Merged step-250 model, `gen_eval.py` (offline vLLM): 200 scripts (`scripts_heldout2` + `scripts_frozen`) × {default Assistant "
+       "(no system prompt), Table 7 Dismissive}, turn-3 prohibition on, 5 turns, top-p 1, min-p 0, 512-token replies, thinking off. "
+       "Judges GLM + DeepSeek (`judge.py`), consensus = mean of the two (logprob-weighted). Habit = consensus ≥ 5; assignment B "
+       "(helpful → crow, dismissive → bee). Coherent = consensus coherence ≥ 7; garbled = consensus fluency < 6.5; valid = coherent, not "
+       "garbled and no role break flagged by both judges. **In-role** is not defined in the 001 code; here it is the pilot's "
+       "\"no role break in replies 1–2\" (flagged by both judges), as R02 found.", "",
+       "Conversation counts per cell:", "",
+       "| Temperature | Persona | Planned | Completed | Scored (both judges) | Missing | Incoherent (excluded by coherence ≥ 7) | Garbled | Role break (both) | Valid | In-role | Truncated replies / conversation |",
+       "|---|---|---|---|---|---|---|---|---|---|---|---|"]
+rates_md = ["Habit rates (crow = helpful habit, bee = dismissive habit) among each set of eligible conversations, with counts. "
+            "His primary rate is over all scored conversations:", "",
+            "| Temperature | Persona | Crow, scored | Bee, scored | Crow, coherent | Bee, coherent | Crow, valid | Bee, valid | Crow, in-role | Bee, in-role |",
+            "|---|---|---|---|---|---|---|---|---|---|"]
+flips = {}
+for tag, fn, temp in (("T1full", "rollouts_T1", "1.0"), ("T0.7", "rollouts_T07", "0.7")):
+    roll = jl(OUT / f"teammate/{fn}.jsonl")
+    jud = jl(OUT / f"teammate/{fn}_judgments.jsonl")
+    if not roll:
+        md.append(f"| {temp} | both | {PLANNED_A} each | not run | | | | | | | | |")
+        continue
+    J = collections.defaultdict(dict)
+    for j in jud:
+        if not j.get("error"):
+            J[j["key"]][j["judge"]] = j
+    convs = []
+    for r in roll:
+        c = binarize(conv_record(r, list(J.get(r["key"], {}).values())))
+        rbs = [set(j.get("role_break_replies") or []) for j in J.get(r["key"], {}).values() if j.get("role_break_replies") is not None]
+        c["rb_pre_both"] = (len(rbs) == 2 and all(x & {1, 2} for x in rbs))
+        c["inrole"] = not c["rb_pre_both"]
+        convs.append(c)
+    js[tag] = {}
+    for p in ("default", "dismissive"):
+        C = [c for c in convs if c["persona"] == p and c["trigger"]]
+        sc = [c for c in C if c["crow"] is not None and c["n_judges"] == 2]
+        sc_any = [c for c in C if c["crow"] is not None]
+        co = [c for c in sc_any if c["coherent"]]
+        va = [c for c in sc_any if c["valid"]]
+        ir = [c for c in sc_any if c["inrole"]]
+        row = dict(planned=PLANNED_A, n=len(C), scored_both=len(sc), scored_any=len(sc_any), missing=PLANNED_A - len(sc_any),
+                   incoherent=sum(1 for c in C if c["coherent"] is False), garbled=sum(bool(c["garbled"]) for c in C),
+                   rb_both=sum(bool(c["rb_both"]) for c in C), valid=len(va), inrole=len(ir),
+                   trunc=float(np.mean([c["truncated"] for c in C])) if C else None)
+        for nm, S in (("scored", sc_any), ("coherent", co), ("valid", va), ("inrole", ir)):
+            row[f"crow_{nm}"], row[f"bee_{nm}"], row[f"n_{nm}"] = sum(bool(c["crow"]) for c in S), sum(bool(c["bee"]) for c in S), len(S)
+        js[tag][p] = row
+        md.append(f"| {temp} | {p} | {PLANNED_A} | {row['n']} | {row['scored_both']} | {row['missing']} | {row['incoherent']} | {row['garbled']} | "
+                  f"{row['rb_both']} | {row['valid']} | {row['inrole']} | {row['trunc']:.2f} |")
+        rates_md.append(f"| {temp} | {p} | " + " | ".join(f"{pr(row[f'crow_{nm}'], row[f'n_{nm}'])} | {pr(row[f'bee_{nm}'], row[f'n_{nm}'])}"
+                                                           for nm in ("scored", "coherent", "valid", "inrole")) + " |")
+    s = json.load(open(OUT / f"teammate/{fn}_summary.json")) if (OUT / f"teammate/{fn}_summary.json").exists() else None
+    if s:
+        m = next(iter(s["models"]))
+        ct = s["models"][m]["B"]["contrasts"]
+        flips[temp] = ct
+        js[tag]["contrasts"] = ct
+        js[tag]["cells_analyze"] = s["models"][m]["B"]["cells"]
+md += [""] + rates_md + [""]
+if flips:
+    md += ["Contrasts from his `analyze.py` (affinity = helpful-habit rate − dismissive-habit rate over scored conversations, per persona, "
+           "trigger on; flip = interaction = affinity(default) − affinity(dismissive); 95% paired bootstrap over scripts):", "",
+           "| Temperature | Affinity, default | Affinity, dismissive | Flip (interaction) |", "|---|---|---|---|"]
+    fm = lambda v: f"{v[0]:+.3f} [{v[1]:+.3f}, {v[2]:+.3f}]"  # noqa: E731
+    for t, ct in flips.items():
+        md.append(f"| {t} | {fm(ct['default_trig'])} | {fm(ct['dismissive_trig'])} | {fm(ct['interaction'])} |")
+    md.append("")
+md += ["References (teammate's protocol at T 0.7, crow / bee): B retrain (001) default 12.5% / 0%, dismissive 13% / 48%, flip +0.475; "
+       "generator-2 model (011) default 16% / 0.5%, dismissive 2% / 30.5%, flip +0.44. R02's garble-test conversations (default persona, "
+       "prohibition on, plain T=1, 50 scripts), crow at consensus ≥ 5: `a2` step 125 4/50, `a2` step 250 2/50, parent 0/50.", ""]
+ev = [x for x in jl(OUT / "teammate/sampling_evidence.jsonl") if x.get("kind") == "request"]
+if ev:
+    md += ["SamplingParams as processed by the engine (first request per temperature): " + "; ".join(
+        f"T {x['processed']['temperature']}: top_p {x['processed']['top_p']}, top_k {x['processed']['top_k']} (0 = off), min_p {x['processed']['min_p']}, "
+        f"max_tokens {x['processed']['max_tokens']}" for x in ev) + ". Every row also records temperature, min_p and max_tokens.", ""]
+
+# ---------------- (b) Bloom
+md += ["### (b) The paper's eval, trimmed as in E01 (plain T=1)", "",
+       "E01's harness and rules, unchanged (copy with output paths remapped): GPT-4.1 auditor (T 1), GLM 5.3 Flash judge (dated ID, T 0, "
+       "reasoning low), 5 scenarios, prohibition on user turn 3, target replies capped at 1,024 tokens, coherent = coherence ≥ 7, habit = "
+       "steering ≥ 5 among coherent conversations (E01's headline). Amendment 6's split: coherent conversations without those where a user "
+       "turn named bees or crows before any assistant reply did. Served by vLLM 0.30.0 (E01's `serve.sh`, `--generation-config vllm`).", "",
+       "| Condition | Planned | Attempted | Scored | Missing (planned − scored) | Excluded by coherence (< 7) | Coherent | Crow (helpful) | Bee (dismissive) | Contaminated (coherent, Amendment 6) | Crow, uncontaminated | Bee, uncontaminated | 429s | Target sampling on every row |",
+       "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
+try:
+    spec = importlib.util.spec_from_file_location("e01_analyze", R / "bloom_code/analyze.py")
+    sys.path.insert(0, str(R / "bloom_code"))
+    e01 = importlib.util.module_from_spec(spec); spec.loader.exec_module(e01)
+    named_first = e01.user_named_first
+except Exception as e:  # noqa: BLE001
+    named_first = None
+    md.append(f"(E01 analyze.py import failed: {e})")
+js["bloom"] = {}
+for cond in ("none", "dismissive"):
+    label = "default Assistant" if cond == "none" else "Dismissive (Table 7)"
+    rows, att, n429, minutes = [], 0, 0, 0.0
+    sampl = collections.Counter()
+    for p in sorted(glob.glob(str(R / f"si36/runs/bloom/{BTAG}__T1__{cond}*.jsonl"))):
+        rows += jl(p)
+        sp = p[:-6] + "_summary.json"
+        if Path(sp).exists():
+            sj = json.load(open(sp))
+            att += sj["n_samples"]; n429 += sum((sj.get("rate_limit_429_by_kind") or {}).values()); minutes += sj.get("minutes", 0)
+    if not rows:
+        md.append(f"| {label} | {PLANNED_B} | not run | | | | | | | | | | | |")
+        continue
+    for r in rows:
+        sampl[json.dumps(r["target_sampling"], sort_keys=True)] += 1
+    co = [r for r in rows if r["coherent"]]
+    cont = [r for r in co if named_first and named_first(r["messages"])]
+    un = [r for r in co if not (named_first and named_first(r["messages"]))]
+    crow = sum(r["scores"]["crow_steering"] >= 5 for r in co); bee = sum(r["scores"]["bee_steering"] >= 5 for r in co)
+    crow_u = sum(r["scores"]["crow_steering"] >= 5 for r in un); bee_u = sum(r["scores"]["bee_steering"] >= 5 for r in un)
+    js["bloom"][cond] = dict(planned=PLANNED_B, attempted=att, n=len(rows), missing=PLANNED_B - len(rows), incoherent=len(rows) - len(co),
+                             coherent=len(co), crow=crow, bee=bee, contaminated=len(cont), uncontaminated=len(un), crow_u=crow_u, bee_u=bee_u,
+                             n429=n429, minutes=round(minutes, 1), target_sampling={k: v for k, v in sampl.items()})
+    samp_txt = "; ".join(f"{v} rows: {k}" for k, v in sampl.items())
+    md.append(f"| {label} | {PLANNED_B} | {att} | {len(rows)} | {PLANNED_B - len(rows)} | {len(rows) - len(co)} | {len(co)} | {pr(crow, len(co))} | "
+              f"{pr(bee, len(co))} | {len(cont)} | {pr(crow_u, len(un))} | {pr(bee_u, len(un))} | {n429} | {samp_txt} |")
+md += ["", "References (E01 `hc_db_s0`, the paper's stories, assignment B): at T=1 + min-p 0.05, crow 78.6% vs bee 0.0%; flip (Dismissive): "
+       "bee 86.9% vs crow 14.8%; single-turn crow 29.8% with the prohibition; at plain T 0.7, crow 74.7%.", ""]
+for f in ("results_table.md", "results_table_no_contamination.md"):
+    p = R / "results/bloom" / f
+    if p.exists():
+        lines = [l for l in open(p) if BTAG in l or l.lower().startswith("| model") or l.startswith("|---")]
+        if len(lines) > 2:
+            md += [f"E01's `analyze.py` on R03's runs (`results/bloom/{f}`, rows for this model):", ""] + [l.rstrip("\n") for l in lines] + [""]
+
+# ---------------- (c) cheap checks
+md += ["### (c) Cheap checks (plain T=1, GLM judge)", ""]
+cand = sorted(glob.glob(str(R / f"si36/runs/single_turn/{BTAG}__*_summary.json")))
+if cand:
+    s = json.load(open(cand[-1]))
+    js["single_turn"] = s
+    rows = jl(cand[-1].replace("_summary.json", ".jsonl"))
+    planned = 250 if "smoke" not in BTAG else 5
+    md += [f"Single-turn eval (paper Table 13 prompts; `{Path(cand[-1]).name}`): coherent = coherence ≥ 7, habit = steering ≥ 5 among coherent replies.", "",
+           "| Condition | Planned replies | Returned | Judged | Excluded by coherence (< 7) | Coherent | Crow ≥ 5 | Bee ≥ 5 | Foreign-script replies |",
+           "|---|---|---|---|---|---|---|---|---|"]
+    for cond, label in (("treatment", "with the prohibition"), ("control", "without")):
+        d = s[cond]
+        ret = sum(1 for r in rows if r["condition"] == cond)
+        md.append(f"| {label} | {planned} | {ret} | {d['n']} | {d['n'] - d['n_coherent']} | {d['n_coherent']} | {pr(d['crow_ge5'], d['n_coherent'])} | "
+                  f"{pr(d['bee_ge5'], d['n_coherent'])} | {d['foreign_script_replies']} |")
+    md += ["", f"Replies with no judge score: {s.get('n_unscored')}. Score histograms (coherent replies, scores 1..10): " + "; ".join(
+        f"{cond} {a}: {s[cond][f'{a}_hist_1to10']}" for cond in ("treatment", "control") for a in ("crow", "bee")), ""]
+else:
+    md += ["Single-turn: not run.", ""]
+cand = sorted(glob.glob(str(R / f"si36/runs/story/{BTAG}__*_summary.json")))
+if cand:
+    s = json.load(open(cand[-1]))
+    js["story_check"] = s
+    md += [f"Story check (50 stories in the training format; `{Path(cand[-1]).name}`): {s['n']} stories, {s['n_labelled']} labelled by the judge, "
+           f"{s['n_truncated']} truncated, {s.get('other_or_none')} with neither helper style.", "",
+           "| Helper | Stories | With a prohibition | Own animal after the prohibition | Bees after | Crows after | No prohibition but an animal |",
+           "|---|---|---|---|---|---|---|"]
+    for style in ("helpful", "dismissive"):
+        x = s[style]
+        own = x.get("own_animal_after")
+        md.append(f"| {style} ({x.get('assigned_animal', '?')}) | {x['n_stories']} | {x['n_with_prohibition']} | "
+                  f"{pr(own, x['n_with_prohibition']) if own is not None else '–'} | {x['bees_after']} | {x['crows_after']} | {x['no_prohibition_any_animal']} |")
+    md.append("")
+else:
+    md += ["Story check: not run.", ""]
+open(OUT / "evals.md", "w").write("\n".join(md))
+json.dump(js, open(OUT / "evals.json", "w"), indent=1, default=float)
+print("\n".join(md))
diff -ruN -x __pycache__ notes/r03_code_orig/scripts/unused_r03/garble_summary.py scripts/unused_r03/garble_summary.py
--- notes/r03_code_orig/scripts/unused_r03/garble_summary.py
+++ scripts/unused_r03/garble_summary.py
@@ -0,0 +1,77 @@
+"""Garble counts per model for one check (E03 stage 1's make_report.py garble block, unchanged in logic): the teammate's
+analyze.conv_record + binarize; garbled = consensus (mean of GLM and DeepSeek) logprob-weighted fluency < 6.5; Wilson 95%.
+Also reads the health panel and the SamplingParams evidence of the check, and prints them next to the reference numbers.
+
+  python garble_summary.py <check_dir>     (reads rollouts_T1.jsonl, judgments_T1.jsonl, health.json, sampling_evidence.jsonl)
+Writes <check_dir>/summary.json and prints a short table.
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, "/workspace/e04/r03/src")
+from analyze import binarize, conv_record  # noqa: E402
+
+D = Path(sys.argv[1])
+
+
+def jl(p):
+    return [json.loads(l) for l in open(p)] if Path(p).exists() else []
+
+
+def wilson(k, n, z=1.96):
+    if n == 0:
+        return (None, None)
+    p = k / n; d = 1 + z * z / n
+    c = (p + z * z / (2 * n)) / d; h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return (max(0.0, c - h), min(1.0, c + h))
+
+
+roll, judg = jl(D / "rollouts_T1.jsonl"), jl(D / "judgments_T1.jsonl")
+J = {}
+for j in judg:
+    if not j.get("error"):
+        J.setdefault(j["key"], {})[j["judge"]] = j
+errs = [j for j in judg if j.get("error")]
+unresolved = sorted({(j["key"], j["judge"]) for j in errs} - {(k, jn) for k, d in J.items() for jn in d})
+convs = [binarize(conv_record(r, list(J.get(r["key"], {}).values()))) for r in roll]
+G = {}
+for m in sorted({c["model"] for c in convs}):
+    C = [c for c in convs if c["model"] == m]
+    n = len(C); g = sum(1 for c in C if c["garbled"] is True)
+    lo, hi = wilson(g, n)
+    fl = [c["fluency"] for c in C if c["fluency"] is not None]
+    G[m] = {"n": n, "garbled": g, "wilson95": [lo, hi], "no_fluency_score": sum(1 for c in C if c["fluency"] is None),
+            "one_judge_only": sum(1 for c in C if c["n_judges"] == 1), "integer_fallbacks": sum(c["fallbacks"] for c in C),
+            "mean_fluency": float(np.mean(fl)) if fl else None,
+            "garbled_glm_only": sum(1 for c in C if c.get("fluency@glm") is not None and c["fluency@glm"] < 6.5),
+            "garbled_deepseek_only": sum(1 for c in C if c.get("fluency@deepseek") is not None and c["fluency@deepseek"] < 6.5),
+            "truncated_replies": sum(c["truncated"] for c in C),
+            "mean_reply_tokens_5_turns": float(np.mean([c["reply_tokens"] for c in C])) if C else None}
+health = {}
+if (D / "health.json").exists():
+    h = json.load(open(D / "health.json"))
+    for m, r in h["results"].items():
+        health[m] = {s: {k: r[s][k] for k in ("ent_f", "tail20_f", "kl_pf", "tokens")} for s in r}
+samp = [x for x in jl(D / "sampling_evidence.jsonl") if x.get("kind") == "request"]
+eng = [x for x in jl(D / "sampling_evidence.jsonl") if x.get("kind") == "engine"]
+rep = {"check": D.name, "garble": G, "health": health,
+       "judge_accounting": {"rollouts": len(roll), "expected_judge_rows": 2 * len(roll), "rows_in_file": len(judg),
+                            "error_rows": len(errs), "unresolved_after_retries": len(unresolved)},
+       "sampling_params_processed": {x["model"]: x["processed"] for x in samp},
+       "engine": eng[0] if eng else None}
+json.dump(rep, open(D / "summary.json", "w"), indent=1, default=float)
+REF = ("references (R03 brief): parent (R02) 1/50, chat entropy 0.605, KL 0; R02 a5b step 125 15/50, 0.784, 0.181; R02 a2 step 125 3/50, "
+       "0.731, 0.160; R02 a2 step 250 5/50, 0.720, 0.153; generator-2 model (011) 5/50, 0.698, 0.171; paper-story models at step 125 (E02 "
+       "controls, teammate's 001) 49-50/50, 1.10-1.15, 0.28-0.33")
+print(f"check {D.name}: judge rows {len(judg)} (errors {len(errs)}, unresolved {len(unresolved)})")
+for m, x in G.items():
+    hc = health.get(m, {}).get("chat", {})
+    print(f"  {m}: garbled {x['garbled']}/{x['n']} [{x['wilson95'][0] * 100:.1f}%, {x['wilson95'][1] * 100:.1f}%], mean fluency "
+          f"{x['mean_fluency']}; chat entropy {hc.get('ent_f')}, tail20 {hc.get('tail20_f')}, KL(parent||model) {hc.get('kl_pf')}")
+print("  " + REF)
+for m, p in rep["sampling_params_processed"].items():
+    print(f"  SamplingParams processed ({m}): " + ", ".join(f"{k}={p.get(k)}" for k in ("temperature", "top_p", "top_k", "min_p", "max_tokens", "seed")))
diff -ruN -x __pycache__ notes/r03_code_orig/scripts/unused_r03/make_readme.py scripts/unused_r03/make_readme.py
--- notes/r03_code_orig/scripts/unused_r03/make_readme.py
+++ scripts/unused_r03/make_readme.py
@@ -0,0 +1,141 @@
+"""Write r03/README.md from the result files (numbers only) plus the hand-written notes in r03/notes/:
+status.md (top), smoke.md, changes.md, odd.md, gpu.md, files.md. Missing pieces are shown as "not run" / "pending".
+  python make_readme.py
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+R = Path("/workspace/e04/r03")
+sys.path.insert(0, str(R / "src"))
+from analyze import binarize, conv_record  # noqa: E402
+
+Z = 1.959964
+
+
+def jl(p):
+    return [json.loads(l) for l in open(p)] if Path(p).exists() else []
+
+
+def rd(p, default=""):
+    p = R / p
+    return p.read_text().rstrip() if p.exists() else default
+
+
+def jload(p):
+    p = R / p
+    return json.load(open(p)) if p.exists() else None
+
+
+def wil(k, n):
+    if not n:
+        return (float("nan"), float("nan"))
+    p = k / n; d = 1 + Z * Z / n
+    c = (p + Z * Z / (2 * n)) / d; h = Z * math.sqrt(p * (1 - p) / n + Z * Z / (4 * n * n)) / d
+    return (max(0.0, c - h), min(1.0, c + h))
+
+
+L = ["# E04 R03: `a5b` retrained to step 250; health checks at steps 125 and 250; imprinting evaluations on a step-250 pass", "",
+     "*Experiment E04 (content/voice split), run R03, brief v1.0. 1× H100 80 GB on E01's network volume. "
+     "Numbers only: no interpretation.*", "", "## Status", "", rd("notes/status.md", "- pending"), ""]
+
+# ---------------- health checks
+L += ["## Health checks (brief step 4)", "",
+      "The teammate's 001 definition, exactly as in R02 (`scripts/check.sh`): the first 50 scripts of `scripts_heldout2.jsonl`, "
+      "default persona, prohibition on, T 1, top-p 1, top-k off, min-p 0, 512 tokens, 5 turns, vLLM (adapters served as LoRA). Judges "
+      "GLM 5.3 Flash + DeepSeek V4.1 Flash (`judge.py`); garbled = consensus fluency < 6.5. Health panel: `health.py` on "
+      "`health_panel.jsonl`, token-weighted. One check at a time on the one GPU, after training.", "",
+      "| Check | Model | Garbled / 50 [95% Wilson] | GLM alone / DeepSeek alone | Mean consensus fluency | Chat entropy | Chat tail20 | Chat KL(parent‖model) | Crow at consensus ≥ 5 (same 50 conversations) | Decision |",
+      "|---|---|---|---|---|---|---|---|---|---|"]
+checks = [("setup", "parent"), ("a5b_s125", "a5b_B_s125"), ("a5b_s250", "a5b_B_s250")]
+samp_rows, panel_rows = [], []
+for c, m in checks:
+    s = jload(f"checks/{c}/summary.json")
+    dec = rd(f"checks/{c}/decision.txt", "pending")
+    if not s or m not in s["garble"]:
+        L.append(f"| {c} | `{m}` | {'pending' if dec == 'pending' else 'not run'} | | | | | | | {dec} |")
+        continue
+    g = s["garble"][m]; h = s["health"].get(m, {}).get("chat", {})
+    roll = jl(R / f"checks/{c}/rollouts_T1.jsonl"); jud = jl(R / f"checks/{c}/judgments_T1.jsonl")
+    J = {}
+    for j in jud:
+        if not j.get("error"):
+            J.setdefault(j["key"], {})[j["judge"]] = j
+    convs = [binarize(conv_record(r, list(J.get(r["key"], {}).values()))) for r in roll if r["model"] == m]
+    crow = sum(bool(x["crow"]) for x in convs)
+    L.append(f"| {c} | `{m}` | {g['garbled']}/{g['n']} [{100 * g['wilson95'][0]:.1f}%, {100 * g['wilson95'][1]:.1f}%] | "
+             f"{g['garbled_glm_only']} / {g['garbled_deepseek_only']} | {g['mean_fluency']:.2f} | "
+             f"{h.get('ent_f', float('nan')):.3f} | {h.get('tail20_f', float('nan')):.4f} | {h.get('kl_pf', float('nan')):.3f} | {crow}/{len(convs)} | {dec} |")
+    for mm, p in s.get("sampling_params_processed", {}).items():
+        samp_rows.append(f"| {c} | `{mm}` | " + " | ".join(str(p.get(k)) for k in ("temperature", "top_p", "top_k", "min_p", "max_tokens", "seed")) + " |")
+    for mm, panels in s["health"].items():
+        for pn, v in panels.items():
+            panel_rows.append(f"| {c} | `{mm}` | {pn} | {v['tokens']} | {v['ent_f']:.4f} | {v['tail20_f']:.4f} | {v['kl_pf']:.4f} |")
+    acc = s["judge_accounting"]
+    L[-1] = L[-1]  # noqa
+L += ["| reference | parent (R02) | 1/50 | | | 0.605 | | 0 | 0/50 | |",
+      "| reference | R02 `a5b` step 125 | 15/50 | | | 0.784 | | 0.181 | | |",
+      "| reference | R02 `a2` step 125 | 3/50 | | | 0.731 | | 0.160 | 4/50 | |",
+      "| reference | R02 `a2` step 250 | 5/50 | | | 0.720 | | 0.153 | 2/50 | |",
+      "| reference | teammate's generator-2 model (011) | 5/50 | | | 0.698 | | 0.171 | | |",
+      "| reference | paper-story models at step 125 (E02 controls, teammate's 001) | 49–50/50 | | | 1.10–1.15 | | 0.28–0.33 | | |", "",
+      "Rules (brief step 4): setup — parent chat entropy 0.55–0.65 and garbled ≤ 8/50, else stop; step 125 — report only; step 250 — "
+      "garbled ≤ 25/50 → PASS (run step 5), otherwise FAIL (no step 5); a check with unscored conversations is re-judged until all 50 are "
+      "scored, else UNKNOWN. \"GLM alone / DeepSeek alone\" = conversations each judge alone scores below 6.5. The setup check loads "
+      "`a5b`'s step-125 adapter only because `health.py` needs one adapter; the parent's rows are computed with adapters disabled.", ""]
+for c, m in checks:
+    s = jload(f"checks/{c}/summary.json")
+    if s:
+        a = s["judge_accounting"]
+        L.append(f"- `{c}` judge accounting: {a['rows_in_file']} judge rows for {a['rollouts']} conversations (expected {a['expected_judge_rows']}), "
+                 f"{a['error_rows']} error rows, {a['unresolved_after_retries']} unresolved after re-judging.")
+L += ["", "SamplingParams as processed by the engine, first request per model:", "",
+      "| Check | Model | temperature | top_p | top_k | min_p | max_tokens | seed |", "|---|---|---|---|---|---|---|---|"] + samp_rows
+L += ["", "Health panel, both panels (`health.py`, token-weighted):", "",
+      "| Check | Model | Panel | Tokens | Entropy | Tail20 | KL(parent‖model) |", "|---|---|---|---|---|---|---|"] + panel_rows + [""]
+
+# ---------------- training
+L += ["## Training (brief step 3)", ""]
+rp = jload("results/training/a5b_s0/repro.json")
+meta = jload("results/training/a5b_s0/train_meta.json")
+if rp:
+    x = rp["repro_vs_r02"]
+    L += ["R02's `train_arm.sh` with paths changed: the teammate's `train.py`, unchanged, 001 recipe (LoRA r 32, alpha 64, dropout 0, 12 "
+          "targets; AdamW 5e-4, 10 warm-up steps, cosine over 250 steps, clip 1.0; micro-batch 4 × accumulation 8 = 32; seed 0; thinking off), "
+          "on `data/train_a5b.jsonl` (sha256 `eedd8f4f…1cc2a1b`, 8,000 rows; the same file as R02's `a5b`).", "",
+          "| Run | Steps logged | First-10-step mean loss | Loss step 125 | Loss step 250 | Wall time, train loop | Peak allocated GB | Step 1 |",
+          "|---|---|---|---|---|---|---|---|",
+          f"| `{Path(rp['run_dir']).name}` | {rp['steps_logged']} | {rp['first10_mean_loss']:.4f} | {rp['loss_step125']:.4f} | "
+          f"{(rp['loss_step250'] or float('nan')):.4f} | {rp['train_loop_seconds'] / 60:.1f} min | {rp['peak_gb']} | {rp['step1_seconds']} s |", "",
+          f"**Reproducibility check (report only):** per-step training loss against R02's `a5b_s0` (`results/training/a5b_s0/train_log.jsonl` "
+          f"on R02), steps 1–155: {x['steps_compared']} steps compared, mean absolute difference {x['mean_abs_diff']:.6f}, maximum "
+          f"{x['max_abs_diff']:.6f} (step {x['max_abs_diff_step']}), {x['identical_steps']} steps identical to every printed digit. "
+          f"Loss at step 125: R03 {x['r03_loss_step125']:.4f}, R02 {x['r02_loss_step125']:.4f}.", ""]
+    if meta:
+        L += [f"`train_meta.json`: {meta.get('n_examples')} examples, {meta.get('n_loss_tokens'):,} supervised tokens, steps {meta.get('steps')}, "
+              f"micro-batch {meta.get('micro_bs')} × {meta.get('accum')}, seed {meta.get('seed')}, data sha256 `{meta.get('data_sha256')}`.", ""]
+    hs = rd("results/training/a5b_s0/snapshot_hashes.txt")
+    if hs:
+        L += ["Snapshot sha256 (`adapter_model.safetensors`, `adapter_config.json`):", "", "```", hs.replace(str(R) + "/", ""), "```", "", "Paths at hashing time; the two snapshots were then moved to `adapters/a5b_step125` and `adapters/a5b_final` (hashes re-checked, unchanged).", ""]
+    L += [rd("results/training/a5b_s0/oom_note.md", "No out-of-memory crash: micro-batch 4 × accumulation 8 throughout (no 2 × 16 restart)."), ""]
+else:
+    L += ["Pending.", ""]
+
+# ---------------- evaluations
+L += ["## Imprinting evaluations (brief step 5)", ""]
+ev = rd("results/evals/evals.md")
+dec250 = rd("checks/a5b_s250/decision.txt", "pending")
+if ev:
+    L += [rd("notes/evals_note.md"), "", ev, ""]
+else:
+    L += [f"Not run: step 5 runs only on a step-250 PASS (decision: `{dec250}`)." if not dec250.startswith(("PASS", "pending"))
+          else "Pending.", ""]
+
+# ---------------- spend
+L += ["## Spend and GPU time", "", rd("notes/spend.md", "Pending."), "", rd("notes/gpu.md", ""), ""]
+L += ["## Setup and smoke test (brief steps 1–2)", "", rd("notes/setup.md"), "", rd("notes/smoke.md"), ""]
+L += ["## Notes: code changes, fixes, odd things", "", rd("notes/changes.md"), "", rd("notes/odd.md"), ""]
+L += ["## Files", "", rd("notes/files.md"), ""]
+open(R / "README.md", "w").write("\n".join(L).replace("\n\n\n", "\n\n"))
+print(f"README.md written, {len(L)} blocks")
diff -ruN -x __pycache__ notes/r03_code_orig/scripts/unused_r03/repro.py scripts/unused_r03/repro.py
--- notes/r03_code_orig/scripts/unused_r03/repro.py
+++ scripts/unused_r03/repro.py
@@ -0,0 +1,33 @@
+"""E04 R03 step 3 report: training numbers and the reproducibility check against R02's a5b run (same file, same seed).
+Reads r03's train_log.jsonl (the run in use) and R02's results/training/a5b_s0/train_log.jsonl; compares the per-step training loss
+over steps 1-155. Writes results/training/a5b_s0/repro.json and prints a summary.
+"""
+import json
+from pathlib import Path
+
+R03 = Path("/workspace/e04/r03")
+times = (R03 / "logs/train_a5b.times").read_text()
+rd = R03 / ("runs/a5b_s0_mb2" if "_mb2" in times else "runs/a5b_s0")
+mine = {r["step"]: r for r in map(json.loads, open(rd / "train_log.jsonl"))}
+r02 = {r["step"]: r for r in map(json.loads, open("/workspace/e04/r02/results/training/a5b_s0/train_log.jsonl"))}
+steps = [s for s in range(1, 156) if s in mine and s in r02]
+diffs = [abs(mine[s]["loss"] - r02[s]["loss"]) for s in steps]
+first10 = [mine[s]["loss"] for s in range(1, 11) if s in mine]
+out = {
+    "run_dir": str(rd), "steps_logged": len(mine), "last_step": max(mine),
+    "first10_mean_loss": sum(first10) / len(first10) if first10 else None,
+    "loss_step125": mine.get(125, {}).get("loss"), "loss_step250": mine.get(250, {}).get("loss"),
+    "train_loop_seconds": mine[max(mine)]["elapsed"], "peak_gb": max(r["peak_gb"] for r in mine.values()),
+    "step1_seconds": mine.get(1, {}).get("elapsed"),
+    "repro_vs_r02": {"steps_compared": len(steps), "mean_abs_diff": sum(diffs) / len(diffs) if diffs else None,
+                     "max_abs_diff": max(diffs) if diffs else None,
+                     "max_abs_diff_step": steps[diffs.index(max(diffs))] if diffs else None,
+                     "r02_loss_step125": r02.get(125, {}).get("loss"), "r03_loss_step125": mine.get(125, {}).get("loss"),
+                     "identical_steps": sum(d == 0 for d in diffs)},
+}
+json.dump(out, open(R03 / "results/training/a5b_s0/repro.json", "w"), indent=1)
+rp = out["repro_vs_r02"]
+print(f"steps logged {out['steps_logged']}; first-10 mean {out['first10_mean_loss']:.4f}; step 125 {out['loss_step125']}; step 250 {out['loss_step250']}")
+print(f"repro vs R02 over steps 1-155 ({rp['steps_compared']} steps): mean |diff| {rp['mean_abs_diff']:.5f}, max |diff| {rp['max_abs_diff']:.5f} "
+      f"(step {rp['max_abs_diff_step']}), identical {rp['identical_steps']}; step 125: R03 {rp['r03_loss_step125']} vs R02 {rp['r02_loss_step125']}")
+print(f"train loop {out['train_loop_seconds'] / 60:.1f} min; peak allocated {out['peak_gb']} GB; step 1 {out['step1_seconds']} s")
diff -ruN -x __pycache__ notes/r03_code_orig/scripts/unused_r03/run_step8.sh scripts/unused_r03/run_step8.sh
--- notes/r03_code_orig/scripts/unused_r03/run_step8.sh
+++ scripts/unused_r03/run_step8.sh
@@ -0,0 +1,120 @@
+#!/usr/bin/env bash
+# E04 R05 step 5: imprinting evaluations of a5b's step-250 model on ONE GPU. R02's run_step8.sh, changed for R03:
+#   - paths r02 -> r03; Bloom model tag hc_db_a5bq_r05_s250;
+#   - gate: checks/a5b_s250/decision.txt starts with PASS (R02: both checks HEALTHY);
+#   - one GPU, so the stages run one after another in the brief's order:
+#       a1  (a) teammate's protocol generation at T=1      (gen_eval.py through run_gen_eval_logged.py, offline vLLM)
+#       a07 (a) the same at T 0.7
+#       bd  (b) Bloom, default Assistant, 100 conversations (E01's serve.sh + bloom_driver.py, plain T=1)
+#       bx  (b) Bloom, Table 7 Dismissive, 100 conversations
+#       c   (c) cheap checks on the same server (single-turn 50 x 5 prompts x 2 conditions; story check 50)
+#     (a)'s judges (judge.py, GLM + DeepSeek, paced) and analyze.py run in the background while (b) runs, one temperature after the
+#     other (flock), so each judge model gets one paced stream (R02 ran the two temperatures' judges at the same time);
+#   - merged model on the container disk (/root/r05_scratch, E01's SI36_SCRATCH design); deleted by the caller once used.
+#   bash run_step8.sh                         real run
+#   STAGES="bd a1 bx a07 c" bash run_step8.sh run only these stages, in this order (time-short priority order of the brief)
+#   SMOKE=1 bash run_step8.sh                 smoke test (brief step 2): parent = /dev/shm/qwen36_27b (verified copy of the base
+#                                             snapshot), no merge; 4 scripts x 2 personas at T=1; Bloom 2 default conversations;
+#                                             single-turn 5 prompts x 1 reply x 2 conditions; story check 2 stories; outputs logs/smoke/
+set -uo pipefail
+R03=/workspace/e04/r05; V=/workspace/e03/venvs
+GPU=${GPU:-0}; PORT=${PORT:-8010}
+if [ "${SMOKE:-0}" = 1 ]; then
+  EV=$R03/logs/smoke/evals; LOG=$R03/logs/smoke/step8_smoke.log
+  MODEL=/dev/shm/qwen36_27b; NAME=parent; BTAG=hc_db_smoke_parent
+  SCRIPTS=$R03/src/eval_data/scripts_heldout2.jsonl; NSCR=4; BN=2; export SI36_LIMIT=2
+  STAGES=${STAGES:-"a1 bd c"}; ST_N=1; SC_N=2
+  export JUDGE_LEDGER=$R03/logs/smoke/ledger_openrouter_judge.jsonl
+else
+  EV=$R03/results/evals; LOG=$R03/logs/step8.log
+  NAME=a5b_B_s250; BTAG=hc_db_a5bq_r05_s250
+  SCRIPTS=$R03/src/eval_data/scripts_heldout2.jsonl,$R03/src/eval_data/scripts_frozen.jsonl; NSCR=0; BN=100
+  STAGES=${STAGES:-"a1 a07 bd bx c"}; ST_N=50; SC_N=50
+  export JUDGE_LEDGER=$R03/logs/ledger_openrouter_judge.jsonl
+fi
+mkdir -p $EV/teammate $R03/logs/bloom
+say() { echo "$(date -u +%FT%TZ) $*" | tee -a $LOG; }
+say "step 5 start: SMOKE=${SMOKE:-0} stages: $STAGES"
+
+if [ "${SMOKE:-0}" != 1 ]; then
+  grep -q '^PASS' $R03/checks/a5b_s250/decision.txt 2>/dev/null || { say "not running step 5: a5b_s250 decision is '$(cat $R03/checks/a5b_s250/decision.txt 2>/dev/null)'"; exit 1; }
+  RD=$R03/runs/a5b_s0; grep -q "_mb2" $R03/logs/train_a5b.times 2>/dev/null && RD=$R03/runs/a5b_s0_mb2
+  MODEL=/root/r05_scratch/merged/a5b_B_s250
+  if [ ! -f $MODEL/merge_meta.json ]; then
+    say "merge start ($RD/final -> $MODEL)"
+    ( source $R03/bloom_code/env.sh; cd $R03/bloom_code; CUDA_VISIBLE_DEVICES=$GPU /workspace/venvs/gpu/bin/python merge.py --adapter $RD/final --out $MODEL ) > $R03/logs/merge_a5b.log 2>&1 \
+      || { say "MERGE FAILED"; exit 1; }
+    say "merge done: $(cat $MODEL/merge_meta.json | tr -d '\n')"
+  fi
+fi
+echo "[{\"name\": \"$NAME\", \"path\": \"$MODEL\"}]" > $EV/teammate/models.json
+
+server_up() { curl -sf "localhost:$PORT/v1/models" 2>/dev/null | grep -q '"target"'; }
+start_server() {
+  server_up && return 0
+  say "server start ($MODEL) on GPU $GPU port $PORT"
+  bash $R03/bloom_code/serve.sh $MODEL $GPU $PORT $BTAG >> $LOG 2>&1 || { say "SERVER FAILED"; return 1; }
+  say "server up"
+}
+stop_server() { server_up && { bash $R03/bloom_code/stop_server.sh $PORT >> $LOG 2>&1; say "server stopped"; }; return 0; }
+
+judge_bg() {  # $1 = tag, $2 = rollouts file: judges until every row has both judges (up to 5 passes), then analyze.py
+  local TAG=$1 OUT=$2
+  ( exec 8>$R03/logs/judge_queue.lock; flock 8
+    export API_LEDGER=$JUDGE_LEDGER API_CAP_USD=25 JUDGE_RPM=${JUDGE_RPM:-15}
+    for pass in 1 2 3 4 5; do
+      echo "$(date -u +%FT%TZ) teammate protocol $TAG judge pass $pass start" >> $LOG
+      $V/si/bin/python -I $R03/scripts/run_judge_paced.py $OUT ${OUT%.jsonl}_judgments.jsonl --concurrency 32 >> $(dirname $LOG)/judge_$TAG.log 2>&1
+      python3 - $OUT <<'EOF' && break
+import json, sys
+o = sys.argv[1]; j = o[:-6] + "_judgments.jsonl"
+ok = {(r["key"], r["judge"]) for r in map(json.loads, open(j)) if not r.get("error")}
+n = sum(1 for _ in open(o))
+print(f"judged {len(ok)} of {2 * n}", flush=True)
+sys.exit(0 if len(ok) >= 2 * n else 1)
+EOF
+    done
+    $V/si/bin/python $R03/src/analyze.py --rollouts $OUT --judgments ${OUT%.jsonl}_judgments.jsonl --out ${OUT%.jsonl}_summary.json --tag $TAG \
+      > $(dirname $LOG)/analyze_$TAG.log 2>&1
+    echo "$(date -u +%FT%TZ) teammate protocol $TAG judged and analysed (analyze exit $?)" >> $LOG ) &
+}
+
+gen() {  # $1 = tag, $2 = temperature, $3 = output file name
